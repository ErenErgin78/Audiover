#!/usr/bin/env bash
# Audiover Desktop App Launcher (Native Rust)

APP_DIR="/opt/audiover"

if [ -f "$APP_DIR/audiover" ]; then
    exec "$APP_DIR/audiover" "$@"
elif command -v /opt/audiover/audiover &>/dev/null; then
    exec /opt/audiover/audiover "$@"
else
    echo "Error: Audiover installation not found in $APP_DIR" >&2
    exit 1
fi
