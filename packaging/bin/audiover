#!/usr/bin/env bash
# Audiover Desktop App Launcher

APP_DIR="/opt/audiover"

if [ -f "$APP_DIR/venv/bin/python3" ]; then
    export PYTHONPATH="$APP_DIR:${PYTHONPATH:-}"
    exec "$APP_DIR/venv/bin/python3" "$APP_DIR/src/main.py" "$@"
elif [ -f "$APP_DIR/src/main.py" ]; then
    export PYTHONPATH="$APP_DIR:${PYTHONPATH:-}"
    exec python3 "$APP_DIR/src/main.py" "$@"
else
    echo "Error: Audiover installation not found in $APP_DIR" >&2
    exit 1
fi
